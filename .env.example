# Autonomous CTF Environment Configuration

# LLM Configuration (default: local Ollama)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=nemotron-3-5-lightning-free

# Alternative: Nemotron (NVIDIA API)
# LLM_PROVIDER=nemotron
# NEMOTRON_API_KEY=your-nemotron-api-key
# NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1
# NEMOTRON_MODEL=nemotron-3-5-lightning-free

# Alternative: OpenAI-compatible
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your-key
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4

# Database
DATABASE_URL=postgresql+asyncpg://ctf:ctf@db:5432/ctf

# Redis
REDIS_URL=redis://redis:6379/0

# Vector Database (optional)
QDRANT_URL=http://qdrant:6333

# System Limits
MAX_AGENT_DEPTH=4
MAX_ACTIVE_AGENTS=32
DEFAULT_AGENT_TIMEOUT=300
DEFAULT_TOKEN_BUDGET=100000

# Docker
DOCKER_NETWORK_PREFIX=ctf
DOCKER_REGISTRY=local

# Paths
WORKSPACE_PATH=/workspace
ARTIFACTS_PATH=/artifacts
LOGS_PATH=/logs

# Security
PERMISSION_MANAGER_PORT=8080
ORCHESTRATOR_PORT=8000
API_KEY=change-this-in-production

# CTF Mode: JEOPARDY | MACHINES | ATTACK_DEFENSE
CTF_MODE=JEOPARDY

# Debug
DEBUG=false
LOG_LEVEL=INFO